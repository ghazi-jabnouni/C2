{
  "name": "automaton-plateform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "server": "node --env-file=.env backend/index.js",
    "start:backend": "node --env-file=.env backend/index.js",
    "dev:backend": "node --env-file=.env backend/index.js",
    "start:frontend": "vite",
    "dev:frontend": "vite",
    "dev": "concurrently \"node --env-file=.env backend/index.js\" \"vite\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/styled-components": "^5.1.36",
    "@types/ws": "^8.18.1",
    "antd": "^6.6.0",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "styled-components": "^6.5.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
