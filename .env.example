# ============================================================
# C2 Platform – Environment Configuration
# Copy this file and rename it .env to customise your instance
# ============================================================

# ── Server ──────────────────────────────────────────────────
# HTTP port the backend Express server listens on
PORT=5000

# Runtime environment: development | production | test
NODE_ENV=development

# Comma-separated list of allowed CORS origins.
# Use * to allow all (not recommended in production).
CORS_ORIGIN=*

# ── Database ─────────────────────────────────────────────────
# Path to the SQLite database file (relative to backend/config/db.js or absolute)
# Default: backend/database/sqlite.db
DB_PATH=

# ── Default Seed Accounts ────────────────────────────────────
# These users are created on first launch if no users exist.
# Change the passwords before deploying to production!

ADMIN_EMAIL=admin@automaton.local
ADMIN_PASSWORD=admin123

REQUESTER_EMAIL=requester@c2platform.local
REQUESTER_PASSWORD=req123

# ── Security ─────────────────────────────────────────────────
# Session TTL in seconds (default: 8 hours = 28800)
SESSION_TTL_SECONDS=28800

# ── Ansible ──────────────────────────────────────────────────
# Override the ansible-playbook binary path if not on PATH
# ANSIBLE_PLAYBOOK_BIN=ansible-playbook

# Default timeout (seconds) for a running Ansible job
ANSIBLE_JOB_TIMEOUT=3600

# ── Terraform ────────────────────────────────────────────────
# Override the terraform binary path if not on PATH
# TERRAFORM_BIN=terraform

# ── Frontend (Vite Dev Server) ───────────────────────────────
# Port for the Vite development server (only used when running locally)
VITE_PORT=3000

# Backend API URL used by the Vite dev proxy
# When running in production the frontend is served by Express itself
VITE_API_TARGET=http://localhost:5000
